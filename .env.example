# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used for admin/service operations. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Vision / Recipe AI provider (choose ONE — or provide both) ───────────
# When both are present, the provider with VISION_PROVIDER=openai or gemini
# is preferred; otherwise the first available key is used.
OPENAI_API_KEY=
# gpt-4o (default). Can be any vision-capable model.
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o

GOOGLE_GENERATIVE_AI_API_KEY=
# gemini-1.5-flash (default) or gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_TEXT_MODEL=gemini-1.5-flash

# Force a specific provider: "openai" | "gemini". Leave empty to auto-detect.
VISION_PROVIDER=

# ── Image upload limits (MB) ────────────────────────────────────────────
MAX_IMAGE_MB=8
